# Opcional: se a pasta ../secure-login tiver um .env, ele já é lido automaticamente.
# Para sobrescrever, copie este arquivo para ".env" (NÃO enviar ao GitHub).

# O MESMO cluster e banco do serviço de login (as sessões ficam lá)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=SecureLogin
MONGODB_DATABASE=securelogin

# Porta do microsserviço (o serviço de login usa a 8080)
CHAMADOS_PORT=8081
